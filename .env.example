# ============================================================
# Spotify Playlist API — Environment Variables
# ============================================================
# Copiar a .env y completar los valores para produccion
# ============================================================

# Base de datos
DB_URL=jdbc:h2:mem:spotifydb
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# H2 Console (debug)
H2_CONSOLE=true

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# JWT
JWT_SECRET=
JWT_EXPIRATION=86400000
